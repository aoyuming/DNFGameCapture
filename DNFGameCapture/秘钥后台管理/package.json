{
  "name": "dnf-capture-admin",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "node admin.js",
    "web": "node admin-web.js",
    "build:exe": "npx --yes @yao-pkg/pkg . --targets node22-win-x64 --output dist/dnf-capture-admin.exe",
    "build:web-exe": "npx --yes @yao-pkg/pkg . --targets node22-win-x64 --output dist/dnf-capture-admin-web.exe",
    "build:cli-exe": "npx --yes @yao-pkg/pkg admin.js --targets node22-win-x64 --output dist/dnf-capture-admin-cli.exe",
    "build:update-uploader-exe": "npx --yes @yao-pkg/pkg update-uploader-console.js --targets node22-win-x64 --output dist/dnf-update-uploader.exe",
    "build:all-exe": "npm.cmd run build:web-exe && npm.cmd run build:cli-exe"
  },
  "bin": "admin-web.js",
  "pkg": {
    "assets": [
      "web-admin/**/*"
    ]
  },
  "dependencies": {
    "ali-oss": "^6.22.0",
    "express": "^4.18.3"
  }
}
